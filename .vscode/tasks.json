    {
      "label": "RobDev: Run & Test Project (Verify All Runnable Parts)",
      "dependsOrder": "parallel",
      "dependsOn": [
        "RobDev: Build Shared (@robdev/shared)",
        "RobDev: Test All Packages (Vitest)",
        "RobDev: Typecheck Shared & Backend",
        "RobDev: Database Up (Postgres 17)",
        "RobDev: Database Seed (Prisma + Vault)"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
